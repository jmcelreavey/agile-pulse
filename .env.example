# Agile Pulse runs with no keys at all: the demo account signs you in, changelogs use the
# built-in writer and emails are logged instead of sent. Copy to .env (or .dev.vars for
# `npm run cf:preview`) and fill in only what you want to switch on. Never commit real values.

# Public URL of this deployment, used for metadata, sitemap and email links.
SITE_URL="http://localhost:3033"

# Show the "Explore the demo" sign-in and the daily-reset notice.
DEMO_MODE="true"

# Auth.js session signing. Required in production: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3033"

# Optional: Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: Jira (Atlassian) sign-in and sprint sync
AUTH_JIRA_CLIENT_ID=""
AUTH_JIRA_CLIENT_SECRET=""

# Optional: AI-written changelogs (falls back to the built-in writer)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: send customer invitations and changelog emails
RESEND_API_KEY=""
EMAIL_FROM="Agile Pulse <noreply@example.com>"

# Optional: show a GitHub link in the footer
REPO_URL=""
