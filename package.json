{
  "name": "agile-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Sprint planning and delivery tracking with a visual sprint chart, snapshots, deadlines, customer portal and changelogs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3033",
    "build": "next build",
    "start": "next start -p 3033",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "npm run demo:sql",
    "demo:sql": "tsx ./scripts/export-demo-sql.ts",
    "docs:build": "tsx ./scripts/build-docs.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:db:reset": "npm run demo:sql && wrangler d1 execute agile-pulse-demo --remote --file=./.demo/demo.sql"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@faker-js/faker": "10.6.0",
    "@hello-pangea/dnd": "18.0.1",
    "@mantine/charts": "9.8.1",
    "@mantine/core": "9.8.1",
    "@mantine/dates": "9.8.1",
    "@mantine/form": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@mantine/notifications": "9.8.1",
    "@mantine/tiptap": "9.8.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "7.10.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "5.108.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@trpc/client": "11.29.4",
    "@trpc/react-query": "11.29.4",
    "@trpc/server": "11.29.4",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "mantine-contextmenu": "9.8.1",
    "marked": "18.2.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-resizable": "4.0.2",
    "react-wrap-balancer": "1.1.1",
    "recharts": "3.11.0",
    "server-only": "0.0.1",
    "superjson": "2.2.6",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@opennextjs/cloudflare": "1.20.17",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "13.2.0",
    "chalk": "6.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.2.0": true
  }
}
